              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"active\": true,\n  \"name\": null,\n  \"filters\": [],\n  \"ordersBy\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/rooms/list",
