                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sala Azul\",\n  \"location\": \"Piso 3\",\n  \"capacity\": 10\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/rooms",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rooms"]
            },
            "description": "Crea una sala. Requiere JWT. Guarda `roomId`."
          },
          "response": []
        },
